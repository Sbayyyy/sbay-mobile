{
  "expo": {
    "name": "SBay",
    "slug": "sbay",
    "version": "1.0.0",
    "description": "سباي سوق سوريا المحلي للبيع والشراء: سيارات، عقارات، إلكترونيات، أثاث، أزياء وإعلانات قريبة مع محادثة آمنة. SBay is Syria's local marketplace.",
    "orientation": "portrait",
    "icon": "./assets/images/playstore-icon.png",
    "scheme": "sbay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syrianbay.app",
      "associatedDomains": [
        "applinks:syrian-bay.com",
        "applinks:www.syrian-bay.com"
      ]
    },
    "android": {
      "package": "com.syrianbay.app",
      "versionCode": 23,
      "icon":"./assets/images/playstore-icon.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/listing/"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/listing/"
            },
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/listings/"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/listings/"
            },
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/auth/verify-email"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/auth/verify-email"
            },
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/api/auth/verify-email"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/api/auth/verify-email"
            },
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/auth/resetPassword"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/auth/resetPassword"
            },
            {
              "scheme": "https",
              "host": "syrian-bay.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "www.syrian-bay.com",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 430,
          "resizeMode": "cover",
          "backgroundColor": "#0f448f",
          "dark": {
            "backgroundColor": "#0f448f"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload listing images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take listing photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2563eb",
          "defaultChannel": "default",
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new notifications"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://api.syrian-bay.com",
      "webBaseUrl": "https://syrian-bay.com",
      "router": {},
      "eas": {
        "projectId": "f0878952-8fa0-487b-9bed-72315aa0823c"
      }
    },
    "owner": "sbay-organization"
  }
}
